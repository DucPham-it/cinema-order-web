        "security": [
          {
            "serviceKey": [],
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "template": "ticket_issued",
                "recipient": "linh@example.test",
                "data": {
                  "bookingId": "b1",
                  "bookingCode": "DEMO-GUEST-CODE",
                  "tickets": [
                    {
                      "seatLabel": "A1",
                      "qrToken": "mock_ticket_qr_token"
                    }
                  ]
                }
              },
              "schema": {
                "type": "object",
                "properties": {
                  "template": {
                    "type": "string",
                    "enum": [
                      "verify_email",
                      "reset_password",
                      "ticket_issued"
                    ]
                  },
                  "recipient": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object"
                  }
                },
                "required": [
                  "template",
                  "recipient",
                  "data"
                ]
              }
            }
          }
        },
        "description": "Trong demo Free, chỉ gửi đến hộp thư được cấu hình. Yêu cầu API key riêng và JWT Ed25519 với aud cinema-notification, scope notifications:send, thời hạn tối đa 60 giây. Với verify_email và reset_password, gửi data.actionUrl cùng origin giao diện. Với ticket_issued, gửi bookingId, bookingCode và tối đa 12 vé."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      },
      "serviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "holdToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Hold-Token"
      },
      "bookingCode": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Booking-Code"
      },
      "webhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Webhook-Signature"
      }
    }
  }
