# Mẫu cấu hình backend. Chép thành .env khi chạy local.

# Ứng dụng và local ports
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
PAYMENT_PORT=3001
NOTIFICATION_PORT=3002
LOG_LEVEL=info
DOWNSTREAM_TIMEOUT_MS=3000

# PostgreSQL và TLS
CORE_DATABASE_URL=postgresql://cinema_local:cinema_local@127.0.0.1:15432/cinema_local
PAYMENT_DATABASE_URL=postgresql://cinema_local:cinema_local@127.0.0.1:15432/cinema_local
NOTIFICATION_DATABASE_URL=postgresql://cinema_local:cinema_local@127.0.0.1:15432/cinema_local
DB_SSL_MODE=disable
DB_SSL_CA_FILE=
DB_POOL_MAX=3
DB_STATEMENT_TIMEOUT_MS=3000

# URL liên dịch vụ
CORE_BASE_URL=http://localhost:3000/api/v1
PAYMENT_BASE_URL=http://localhost:3001/api/v1
NOTIFICATION_BASE_URL=http://localhost:3002/api/v1

# Notification và demo email
CORE_TO_NOTIFICATION_API_KEY=
CORE_SERVICE_PUBLIC_KEY=
CORE_SERVICE_PUBLIC_KEY_FILE=
CORE_SERVICE_PRIVATE_KEY_FILE=
SERVICE_TOKEN_ISSUER=cinema-services
MAIL_TRANSPORT=smtp
MAIL_FROM=Cinema <tickets@example.test>
MAIL_DEMO_RECIPIENT=demo@example.test
MAIL_ACTION_ORIGIN=http://localhost:5173
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false

# Biến bổ sung cho các module theo kế hoạch
JWT_ISSUER=cinema-core
JWT_AUDIENCE=cinema-web
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true
BOOKING_HOLD_SECONDS=300
BOOKING_CANCEL_BEFORE_MINUTES=120
PAYMENT_SIMULATION_ENABLED=true
CORE_TO_PAYMENT_API_KEY=
PAYMENT_TO_CORE_API_KEY=
PAYMENT_WEBHOOK_HMAC_SECRET=
PAYMENT_SERVICE_PRIVATE_KEY_FILE=
PAYMENT_SERVICE_PUBLIC_KEY_FILE=
SERVICE_TOKEN_TTL_SECONDS=60
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
SMTP_USER=
SMTP_PASS=
